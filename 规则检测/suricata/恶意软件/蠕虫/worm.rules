# Converted from Sangfor export: etc_fw/sf_snort/rules/worm.rules
# rules=2 skipped=1 dup_sid=0
alert tcp any any -> any $HTTP_PORTS (http.uri; content:"/search?q="; pcre:"/\/search\?q=[0-9]{1,3}(&aq=7(\?[0-9a-f]{8})?)?$/"; msg:"Trojan Win.Trojan.Conficker Variant Connection"; flow:to_server,established; sid:10050001; rev:1;)
alert tcp any any -> any $HTTP_PORTS (content:"HOST|3a|www|2e|worm|2e|com"; msg:"Worm Code Red II Traffic Detection"; flow:to_server,established; sid:10050002; rev:1;)
