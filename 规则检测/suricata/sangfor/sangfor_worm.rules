# Converted from Sangfor export: etc_fw/sf_snort/rules/worm.rules
# rules=3 skipped=0 dup_sid=0
alert tcp any any -> any $HTTP_PORTS (msg:"Trojan Win.Trojan.Conficker Variant Connection"; flow:to_server,established; content:"/search?q="; http_uri; pcre:"/\/search\?q=[0-9]{1,3}(&aq=7(\?[0-9a-f]{8})?)?$/U"; sid:10050001; rev:1;);
alert tcp any any -> any $HTTP_PORTS (msg:"Worm Code Red II Traffic Detection"; flow:to_server,established; content:"|2f|default|2e|ida|3f|"; http_only_uri; pcre:"/\x2fdefault\x2eida\x3f[NX]{220,}/i"; sid:10050003; rev:1;);
alert tcp any any -> any $HTTP_PORTS (msg:"Worm Code Red II Traffic Detection"; flow:to_server,established; content:"HOST|3a|www|2e|worm|2e|com"; sid:10050002; rev:1;);
