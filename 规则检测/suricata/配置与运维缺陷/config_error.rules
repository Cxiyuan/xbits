alert tcp any $HTTP_PORTS -> any any (content:"allowscriptAccess"; nocase; pcre:"/<[\s]*param[\s]+name=[\s\x22\x27]+allowScriptAccess[^>]*value[\s]*=[\s\x22\x27]+always/i"; msg:"Insecure Configuration Detected on Target Server Flash"; flow:to_client,established; sid:14070090; rev:2;)
