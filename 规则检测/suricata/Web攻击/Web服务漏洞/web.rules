alert tcp any any -> any $HTTP_PORTS (msg:"HP OpenView Network Node Manager DoLoad Remote Buffer Overflow Vulnerability(CVE-2010-1552)"; flow:to_server,established; content:"/OvCgi/snmpviewer.exe"; http_uri; nocase; pcre:"/(act|app)=[^\x00\x0d\x0b\x26]{300}/iU"; sid:11023229; rev:1;)
alert tcp any any -> any $HTTP_PORTS (msg:"Novell iManager getMultiPartParameters Arbitrary File Upload Vulnerability"; flow:to_server,established; content:"/nps/servlet/modulemanager"; nocase; pcre:"/filename=(\x22)?\x2e\x2e(\x5c|\x2f)/i"; sid:11023236; rev:1;)
alert tcp any any -> any $HTTP_PORTS (msg:"Novell ZENworks Configuration Management Remote Execution Remote Code Execution Vulnerability"; flow:to_server,established; content:"zenworks/UploadServlet?filename=../"; nocase; content:".war"; nocase; sid:11023238;)
alert tcp any any -> any 6660 (msg:"BigAnt IM Server USV Request Buffer Overflow Vulnerability"; flow:to_server,established; content:"USV "; nocase; pcre:"/USV[\t ][^\x0d\x0a]{962}/i"; sid:11023241;)
alert tcp any any -> any $HTTP_PORTS (msg:"Splunk 5.0 Custom App Remote Code Execution Vulnerability"; flow:established,to_server; content:"/en-US/api/search/jobs"; http_uri; nocase; content:"search=search"; http_uri; nocase; pcre:"/search=search\s+\x2a\s+\x7c\s+script\s/iU"; sid:11023282; rev:1;)
alert tcp any any -> any $HTTP_PORTS (msg:"Adobe Flash Player And AIR Remote Security Bypass Vulnerability(CVE-2014-0491)"; flow:to_server,established; content:"jar|3a|javascript|3a|"; http_uri; nocase; sid:11023343; rev:1;)
alert tcp any any -> any $HTTP_PORTS (msg:"UEditor File upload bypass vulnerability"; flow:to_server,established; content:"/ueditor/upload"; http_uri; nocase; pcre:"/(myEditors|editorValue)\s*=[^&]*\.(jpg|png|jpeg|gif|bmp)\.jsp/iU"; sid:11023417; rev:1;)
alert tcp any any -> any $HTTP_PORTS (msg:"Gitlab Ssh Key Upload Remote Command Execution Vulnerability(CVE-2013-4490)"; flow:to_server,established; content:"|2f|keys"; http_uri; nocase; content:"_gitlab_session"; nocase; pcre:"/[\x5e\x26]key\x5bkey\x5d\s*=\s*[^\x26\x3b]*[\x60\x3b\x7c]/iU"; sid:11023419; rev:1;)
