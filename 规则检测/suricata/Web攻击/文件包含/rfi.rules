alert tcp any any -> any $HTTP_PORTS (http.uri; content:".php?"; nocase; content:"=include"; nocase; pcre:"/\.php\?[^\r\n]{0,256}=include(_once)?\((ftp|ftps|https|http|file):\/{1,2}[^)\r\n)]{1,256}\)/i"; msg:"File Inclusion Vulnerability Detected on Taget Website"; flow:to_server,established; lua:traversal_context.lua;  sid:14020001; rev:2;)
alert tcp any any -> any $HTTP_PORTS (http.uri; content:".php?"; nocase; content:"=require"; nocase; pcre:"/\.php\?[^\r\n]{0,256}=require(_once)?\((ftp|ftps|https|http|file|expect):\/{1,2}[^)\r\n)]{1,256}\)/i"; msg:"File Include Vulnerability Detected on Target Website"; flow:to_server,established; lua:traversal_context.lua;  sid:14020003; rev:2;)
alert tcp any any -> any $HTTP_PORTS (http.uri; content:".php?"; nocase; content:"=http"; nocase; pcre:"/[\?&][\w\[\]-]{1,256}=https?:\/{1,2}[^\r\n]{1,256}\.[a-zA-Z]{2,5}/i"; msg:"File Inclusion Vulnerability Detected on Target Website	"; flow:to_server,established; lua:traversal_context.lua;  sid:14020005; rev:2;)
alert tcp any any -> any $HTTP_PORTS (http.uri; content:".php?"; nocase; content:"=ftp"; nocase; pcre:"/[\?&][\w\[\]-]{1,256}=ftps?:\/{1,2}[^\r\n]{1,256}\.[a-zA-Z]{2,5}/i"; msg:"File Inclusion Vulnerability Detected on Target Website"; flow:to_server,established; lua:traversal_context.lua;  sid:14020007; rev:2;)
alert tcp any any -> any $HTTP_PORTS (http.uri; content:"|2e|php|3F|"; nocase; content:"|3D|file|3A 2F|"; nocase; pcre:"/[\?&][\w\[\]-]{1,256}=file\x3a\/{1,2}[^\r\n]{1,256}\x2e[a-zA-Z]{2,5}/i"; msg:"File Inclusion Vulnerability Detected on Target Website"; flow:to_server,established; lua:traversal_context.lua;  sid:14020009; rev:2;)
