# ---------------------------------------------------------------------------
# 通用脚本客户端：只做 telemetry；用 type both 限频，不做 detection_filter
# ---------------------------------------------------------------------------

alert http $EXTERNAL_NET any -> $HOME_NET any ( \
    msg:"[侦察] 外部源高频脚本化 HTTP 客户端访问（非攻击确认）"; \
    flow:to_server,established; \
    http.user_agent; bsize:>0; \
    pcre:"/^(?:curl\/|wget\/|python-requests\/|python-urllib\/|go-http-client\/|java\/|okhttp\/|aiohttp\/|libwww-perl\/|lwp::simple\/)/i"; \
    threshold: type both, track by_src, count 50, seconds 60; \
    classtype:network-scan; \
    metadata:attack_tactic TA0043, attack_technique T1595.002, confidence Low, severity Info, tier telemetry, created_at 2026_10_18, updated_at 2026_11_07; \
    sid:9101028; rev:3;)

alert http $CLIENT_NET any -> $EXTERNAL_NET any ( \
    msg:"[侦察] 内网主机高频使用脚本化 HTTP 客户端外联（非攻击确认）"; \
    flow:to_server,established; \
    http.user_agent; bsize:>0; \
    pcre:"/^(?:curl\/|wget\/|python-requests\/|python-urllib\/|go-http-client\/|java\/|okhttp\/|aiohttp\/|libwww-perl\/|lwp::simple\/)/i"; \
    threshold: type both, track by_src, count 60, seconds 60; \
    classtype:network-scan; \
    metadata:attack_tactic TA0043, attack_technique T1595.002, confidence Low, severity Low, tier telemetry, created_at 2026_10_18, updated_at 2026_11_07; \
    sid:9101029; rev:3;)

# ---------------------------------------------------------------------------
# 上下文关联：已知攻击工具 + 敏感路径
# ---------------------------------------------------------------------------

alert http $EXTERNAL_NET any -> $HOME_NET any ( \
    msg:"[侦察] 已知攻击工具探测敏感路径"; \
    flow:to_server,established; \
    http.uri; bsize:>0; \
    lua:recon_context.lua; \
    flowbits:set,recon_sensitive_probe; \
    threshold: type limit, track by_src, count 1, seconds 60; \
    classtype:attempted-recon; \
    metadata:attack_tactic TA0043, attack_technique T1595.002, confidence High, severity High, tier alert, engine lua, created_at 2026_11_07, updated_at 2026_11_07; \
    sid:9101101; rev:1;)

alert http $HOME_NET any -> $EXTERNAL_NET any ( \
    msg:"[侦察] 已知攻击工具敏感路径访问成功（HTTP 2xx）"; \
    flow:established,to_client; \
    flowbits:isset,recon_sensitive_probe; \
    http.stat_code; pcre:"/^2[0-9][0-9]$/"; \
    lua:recon_context.lua; \
    threshold: type limit, track by_dst, count 1, seconds 60; \
    classtype:successful-recon-limited; \
    metadata:attack_tactic TA0043, attack_technique T1595.002, confidence High, severity High, tier alert, engine lua, created_at 2026_11_07, updated_at 2026_11_07; \
    sid:9101102; rev:1;)

alert http $HOME_NET any -> $EXTERNAL_NET any ( \
    msg:"[侦察] 已知攻击工具敏感路径被保护但仍被探测（HTTP 401/403）"; \
    flow:established,to_client; \
    flowbits:isset,recon_sensitive_probe; \
    http.stat_code; pcre:"/^(?:401|403)$/"; \
    lua:recon_context.lua; \
    threshold: type limit, track by_dst, count 1, seconds 60; \
    classtype:attempted-recon; \
    metadata:attack_tactic TA0043, attack_technique T1595.002, confidence High, severity Medium, tier alert, engine lua, created_at 2026_11_07, updated_at 2026_11_07; \
    sid:9101107; rev:1;)

# ---------------------------------------------------------------------------
# 无 UA 依赖：外部源高频探测敏感路径，响应侧确认
# ---------------------------------------------------------------------------

alert http $EXTERNAL_NET any -> $HOME_NET any ( \
    msg:"[侦察] 外部源高频探测敏感路径"; \
    flow:to_server,established; \
    http.uri; bsize:>0; \
    lua:recon_path.lua; \
    threshold: type both, track by_src, count 20, seconds 60; \
    classtype:attempted-recon; \
    metadata:attack_tactic TA0043, attack_technique T1595.002, confidence Medium, severity Medium, tier triage, engine lua, created_at 2026_11_07, updated_at 2026_11_07; \
    sid:9101103; rev:1;)

alert http $HOME_NET any -> $EXTERNAL_NET any ( \
    msg:"[侦察] 外部源高频敏感路径探测收到响应（2xx/3xx/4xx/5xx）"; \
    flow:established,to_client; \
    http.stat_code; pcre:"/^(?:2[0-9][0-9]|3[0-9][0-9]|4[0-9][0-9]|5[0-9][0-9])$/"; \
    lua:recon_path.lua; \
    threshold: type both, track by_dst, count 20, seconds 60; \
    classtype:attempted-recon; \
    metadata:attack_tactic TA0043, attack_technique T1595.002, confidence Medium, severity Medium, tier triage, engine lua, created_at 2026_11_07, updated_at 2026_11_07; \
    sid:9101104; rev:1;)

# ---------------------------------------------------------------------------
# 方向补齐：内网外联/内网横向使用已知工具 UA
# ---------------------------------------------------------------------------

alert http $CLIENT_NET any -> $EXTERNAL_NET any ( \
    msg:"[侦察] 内网主机外联使用攻击工具 User-Agent"; \
    flow:to_server,established; \
    http.user_agent; bsize:>0; \
    lua:recon_ua.lua; \
    threshold: type limit, track by_src, count 1, seconds 60; \
    classtype:attempted-recon; \
    metadata:attack_tactic TA0043, attack_technique T1595.002, confidence High, severity High, tier alert, engine lua, created_at 2026_11_07, updated_at 2026_11_07; \
    sid:9101105; rev:1;)

alert http $HOME_NET any -> $HOME_NET any ( \
    msg:"[侦察] 内网主机使用攻击工具扫描内网"; \
    flow:to_server,established; \
    http.user_agent; bsize:>0; \
    lua:recon_ua.lua; \
    threshold: type limit, track by_src, count 1, seconds 60; \
    classtype:attempted-recon; \
    metadata:attack_tactic TA0043, attack_technique T1595.002, confidence Medium, severity Medium, tier triage, engine lua, created_at 2026_11_07, updated_at 2026_11_07; \
    sid:9101106; rev:1;)

# ---------------------------------------------------------------------------
# 响应体确认：软 404 抑制后，只有真实泄露标记才升级为 Critical
# ---------------------------------------------------------------------------

alert http $HOME_NET any -> $EXTERNAL_NET any ( \
    msg:"[侦察] 敏感路径响应体确认泄露内容"; \
    flow:established,to_client; \
    flowbits:isset,recon_sensitive_probe; \
    http.response_body; bsize:>0; \
    lua:recon_body.lua; \
    threshold: type limit, track by_dst, count 1, seconds 60; \
    classtype:successful-recon-limited; \
    metadata:attack_tactic TA0043, attack_technique T1595.002, confidence High, severity Critical, tier alert, engine lua, created_at 2026_11_07, updated_at 2026_11_07; \
    sid:9101108; rev:1;)

# ---------------------------------------------------------------------------
# 无 UA 依赖：403/404 高频突发（目录/路径爆破）
# ---------------------------------------------------------------------------

alert http $HOME_NET any -> $EXTERNAL_NET any ( \
    msg:"[侦察] 外部源高频 403/404 响应（疑似目录/路径爆破）"; \
    flow:established,to_client; \
    http.stat_code; pcre:"/^(?:403|404)$/"; \
    lua:recon_404.lua; \
    threshold: type both, track by_dst, count 50, seconds 60; \
    classtype:attempted-recon; \
    metadata:attack_tactic TA0043, attack_technique T1595.003, confidence Medium, severity Medium, tier triage, engine lua, created_at 2026_11_07, updated_at 2026_11_07; \
    sid:9101109; rev:1;)

# ---------------------------------------------------------------------------
# 工具专用请求头（HTTP/1 与 HTTP/2）
# ---------------------------------------------------------------------------

alert http $EXTERNAL_NET any -> $HOME_NET any ( \
    msg:"[侦察] 攻击工具指纹 - Acunetix Aspect/Product 请求头"; \
    flow:to_server,established; \
    http.request_header; content:"Acunetix-"; nocase; fast_pattern; \
    pcre:"/Acunetix-(?:Aspect|Product)/i"; \
    threshold: type limit, track by_src, count 1, seconds 60; \
    classtype:attempted-recon; \
    metadata:attack_tactic TA0043, attack_technique T1595.002, confidence High, severity Medium, tier alert, tool acunetix, created_at 2026_11_07, updated_at 2026_11_07; \
    sid:9101110; rev:1;)

# ---------------------------------------------------------------------------
# 测绘工具 UA 单独分级；包裹/多值 UA 补充规则
# ---------------------------------------------------------------------------

alert http $CLIENT_NET any -> $EXTERNAL_NET any ( \
    msg:"[侦察] 内网主机外联使用互联网测绘/资产扫描 UA"; \
    flow:to_server,established; \
    http.user_agent; bsize:>0; \
    lua:recon_scanner_ua.lua; \
    threshold: type limit, track by_src, count 1, seconds 60; \
    classtype:network-scan; \
    metadata:attack_tactic TA0043, attack_technique T1595.001, confidence High, severity Info, tier telemetry, engine lua, created_at 2026_11_07, updated_at 2026_11_07; \
    sid:9101111; rev:1;)

alert http $EXTERNAL_NET any -> $HOME_NET any ( \
    msg:"[侦察] 已知攻击工具 UA 包裹/前缀变体"; \
    flow:to_server,established; \
    http.user_agent; bsize:>0; \
    lua:recon_wrapped_ua.lua; \
    threshold: type limit, track by_src, count 1, seconds 60; \
    classtype:attempted-recon; \
    metadata:attack_tactic TA0043, attack_technique T1595.002, confidence Medium, severity Medium, tier triage, engine lua, created_at 2026_11_07, updated_at 2026_11_07; \
    sid:9101112; rev:1;)

# ---------------------------------------------------------------------------
# 异常 HTTP 方法 / Host 组合
# ---------------------------------------------------------------------------

alert http $EXTERNAL_NET any -> $HOME_NET any ( \
    msg:"[侦察] 外部源异常 HTTP 方法/Host 组合"; \
    flow:to_server,established; \
    http.method; pcre:"/^(?:TRACE|TRACK|PROPFIND|MKCOL|PUT|DELETE)$/"; \
    lua:recon_method.lua; \
    threshold: type limit, track by_src, count 1, seconds 60; \
    classtype:attempted-recon; \
    metadata:attack_tactic TA0043, attack_technique T1595.002, confidence Medium, severity Medium, tier triage, engine lua, created_at 2026_11_07, updated_at 2026_11_07; \
    sid:9101113; rev:1;)
