# ============================================================================
# 侦察与攻击工具指纹 · Suricata 8.0.8
# ----------------------------------------------------------------------------
# 目标版本 : Suricata 8.0.8（不向下兼容）
# 场景     : HTTP 侦察/扫描工具指纹、敏感路径探测、脚本化客户端
# 规则数量 : 41
# SID 段   : 9101001-9101029（工具/脚本客户端）
#            9101101-9101113（上下文、响应确认、路径/4xx 突发、外联与内网）
#
# 检测分层
#   tier alert     : 已知工具默认 UA 的精确前缀/边界匹配；来源受控
#   tier triage    : 已知工具 + 敏感路径/响应确认；外部源敏感路径高频探测
#   tier telemetry : 互联网测绘爬虫、masscan/zgrab、通用脚本客户端高频访问
#
# 方向约定
#   $EXTERNAL_NET -> $HOME_NET : 外部对内部服务的侦察
#   $CLIENT_NET  -> $EXTERNAL_NET : 内网主机外联/外发扫描
#   $HOME_NET    -> $HOME_NET : 内网横向扫描
#   $HOME_NET    -> $EXTERNAL_NET : 内部服务返回给外部客户端的响应
#
# 说明
#   1. User-Agent 可被任意伪造。本文件命中表示“工具/行为线索”，不是攻击成功。
#   2. Suricata 8.0.8 仍支持 threshold / detection_filter；二者未弃用。
#      本文件全部使用 threshold，不使用 detection_filter，避免“达到阈值后每条都告警”。
#   3. 所有 UA 规则使用 ^ 锚定或分隔符边界，避免 httpx 命中 python-httpx、
#      Java/ 命中正常 Java 客户端等子串误报。
#   4. 未覆盖 HTTPS 加密流量中的 UA。TLS 流量需要在 Suricata 解密后，
#      或使用 JA3/JA4、SNI、连接行为等旁路信号，不能宣称已覆盖。
#   5. 授权扫描器、API 网关、健康检查应通过 $SCANNER_NET / 全局 suppress
#      或 event_filter 抑制；不要在规则里放行整个云厂商或公共后缀。
# ============================================================================

# ---------------------------------------------------------------------------
# 词表/目录爆破工具：T1595.003 Wordlist Scanning
# ---------------------------------------------------------------------------

alert http $EXTERNAL_NET any -> $HOME_NET any ( \
    msg:"[侦察] 攻击工具指纹 - ffuf 目录与参数爆破工具"; \
    flow:to_server,established; \
    http.user_agent; content:"Fuzz Faster U Fool"; nocase; fast_pattern; \
    pcre:"/^Fuzz Faster U Fool\b/i"; \
    threshold: type limit, track by_src, count 1, seconds 60; \
    classtype:attempted-recon; \
    metadata:attack_tactic TA0043, attack_technique T1595.003, confidence High, severity High, tier alert, tool ffuf, created_at 2026_10_18, updated_at 2026_11_07; \
    sid:9101001; rev:2;)

