# ============================================================================
# WebShell 后门通信 · Suricata 8.0.8
# ----------------------------------------------------------------------------
# 目标版本 : Suricata 8.0.8（不向下兼容）
# 场景     : WebShell 文件访问、命令参数、响应确认、管理工具 UA
# 规则数量 : 4
# SID 段   : 9104001-9104004
#
# 说明
#   1. 外部 -> 内部方向；不使用 any any。
#   2. 9104001 只是“已知 WebShell 文件名访问”线索，降为 triage；
#      不能仅凭 shell.php 就判为后门。
#   3. 9104002 检查 URI/请求体/Cookie/请求头中的命令参数名和值，
#      修复原规则把参数名/值写反的问题。
#   4. 9104003 在响应侧确认命令输出/文件管理/错误回显，使用 flowbits 关联。
#   5. 9104004 仅是管理工具 UA 遥测线索，可伪造，不单独告警。
# ============================================================================

alert http $EXTERNAL_NET any -> $HOME_NET any ( \
    msg:"[后门通信] WebShell - 已知后门文件名访问（线索）"; \
    flow:to_server,established; \
    http.uri.raw; bsize:>0; \
    lua:webshell_path.lua; \
    flowbits:set,webshell_probe; \
    threshold: type limit, track by_src, count 1, seconds 60; \
    classtype:web-application-attack; \
    metadata:attack_tactic TA0003, attack_technique T1505.003, confidence Medium, severity Medium, tier triage, engine lua, category webshell-path, created_at 2026_10_18, updated_at 2026_11_07; \
    sid:9104001; rev:2;)

alert http $EXTERNAL_NET any -> $HOME_NET any ( \
    msg:"[后门通信] WebShell - 命令参数与命令/代码值"; \
    flow:to_server,established; \
    http.uri.raw; bsize:>0; \
    lua:webshell_param.lua; \
    flowbits:set,webshell_probe; \
    threshold: type limit, track by_src, count 1, seconds 60; \
    classtype:trojan-activity; \
    metadata:attack_tactic TA0003, attack_technique T1505.003, confidence High, severity Critical, tier alert, engine lua, category webshell-command, created_at 2026_10_18, updated_at 2026_11_07; \
    sid:9104002; rev:2;)

alert http $HOME_NET any -> $EXTERNAL_NET any ( \
    msg:"[后门通信] WebShell - 响应确认命令输出/文件管理/错误回显"; \
    flow:established,to_client; \
    flowbits:isset,webshell_probe; \
    http.response_body; bsize:>0; \
    lua:webshell_response.lua; \
    threshold: type limit, track by_dst, count 1, seconds 60; \
    classtype:trojan-activity; \
    metadata:attack_tactic TA0003, attack_technique T1505.003, confidence High, severity Critical, tier alert, engine lua, category webshell-response, created_at 2026_11_07, updated_at 2026_11_07; \
    sid:9104003; rev:1;)

alert http $EXTERNAL_NET any -> $HOME_NET any ( \
    msg:"[后门通信] WebShell - 管理工具 UA 线索（可伪造）"; \
    flow:to_server,established; \
    http.user_agent; pcre:"/(antSword|Behinder|Godzilla|b374k|c99|wso)/i"; \
    threshold: type limit, track by_src, count 1, seconds 300; \
    classtype:misc-activity; \
    metadata:attack_tactic TA0003, attack_technique T1505.003, confidence Low, severity Info, tier telemetry, category webshell-tool-ua, created_at 2026_11_07, updated_at 2026_11_07; \
    sid:9104004; rev:1;)
