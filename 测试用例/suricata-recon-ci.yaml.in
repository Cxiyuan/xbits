%YAML 1.1
---
# CI-only Suricata 8.0.8 configuration for the recon-tool scenario.
# Paths are substituted by the workflow.
default-log-dir: __LOG_DIR__

vars:
  address-groups:
    # Test server/client network.
    HOME_NET: "[10.0.0.0/8]"
    # Test external network (RFC 5737). Production should use !$HOME_NET
    # and should exclude authorized scanner networks via suppression.
    EXTERNAL_NET: "[203.0.113.0/24]"
    CLIENT_NET: "[10.0.0.0/8]"

default-rule-path: __RULE_DIR__
rule-files:
  - 侦察与攻击工具指纹规则.rules

classification-file: __RULE_DIR__/classification.config
reference-config-file: __RULE_DIR__/reference.config

security:
  lua:
    allow-rules: yes

outputs:
  - eve-log:
      enabled: yes
      community-id: true
      community-id-seed: 0
      filetype: file
      filename: eve.json
      types:
        - alert:
            payload: yes
        - http:
            extended: yes
