%YAML 1.1
---
# CI-only Suricata 8.0.8 configuration. Paths are substituted by the workflow.
default-log-dir: __LOG_DIR__

vars:
  address-groups:
    HOME_NET: "[10.0.0.0/8]"
    CLIENT_NET: "[10.0.0.0/8]"

default-rule-path: __RULE_DIR__
rule-files:
  - DNS隧道与带外检测规则.rules

classification-file: __RULE_DIR__/classification.config
reference-config-file: __RULE_DIR__/reference.config

app-layer:
  protocols:
    tls:
      enabled: yes
      detection-ports:
        dp: 443, 853

security:
  lua:
    allow-rules: yes

outputs:
  - eve-log:
      enabled: yes
      filetype: file
      filename: eve.json
      types:
        - alert:
            payload: yes
        - dns:
            query: yes
            answer: yes
        - http
        - tls
